# PostgreSQL connection used by Prisma. Do not use SQLite for the shared deployment.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/school_banchee?schema=public

# Required by the School Directory seed because data/schools.csv has no ESAO code.
SCHOOL_SEED_ESAO_CODE=1000960001

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# The bootstrap command will use this identity for the first System Admin.
# Supply the initial password interactively or through a short-lived secret,
# never in a committed environment file.
BOOTSTRAP_ADMIN_EMAIL=

# Required only by the sealed initial pilot policy activation command.
# The command rejects any value other than the authorized bootstrap start.
INITIAL_POLICY_EFFECTIVE_START=2026-08-12T00:00:00+07:00
