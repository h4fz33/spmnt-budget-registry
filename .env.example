# MongoDB must be a replica set or sharded cluster for financial transactions.
MONGODB_URI=mongodb://127.0.0.1:27017/?replicaSet=rs0
MONGODB_DB_NAME=school_banchee

# Required by the School Directory seed because data/schools.csv has no ESAO code.
SCHOOL_SEED_ESAO_CODE=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret

# The bootstrap command will use this identity for the first System Admin.
# Supply the initial password interactively or through a short-lived secret,
# never in a committed environment file.
BOOTSTRAP_ADMIN_EMAIL=
